// Copy this to terraform.tfvars and fill in your subscription id.
// terraform.tfvars is gitignored; this example file is not.
//
//   cp terraform.tfvars.example terraform.tfvars
//   az account show --query id -o tsv        # paste the result below

subscription_id = "00000000-0000-0000-0000-000000000000"

// Everything below has a working default in variables.tf. Uncomment only to
// override.
//
